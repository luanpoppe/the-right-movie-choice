generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  name         String
  passwordHash String?
  googleId     String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movieEntries           UserMovieEntry[]
  conversations          UserConversation[]
  friendRequestsSent     FriendRequest[]    @relation("FriendRequestRequester")
  friendRequestsReceived FriendRequest[]    @relation("FriendRequestAddressee")
  ownedGroups            UserGroup[]        @relation("UserGroupOwner")
  groupMemberships       GroupMember[]
  groupInvitesSent       GroupInvite[]      @relation("GroupInviteInviter")
  groupInvitesReceived   GroupInvite[]      @relation("GroupInviteInvitee")
}

enum FriendRequestStatus {
  pending
  accepted
  rejected
}

model FriendRequest {
  id          Int                 @id @default(autoincrement())
  requesterId Int
  requester   User                @relation("FriendRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId Int
  addressee   User                @relation("FriendRequestAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendRequestStatus @default(pending)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([requesterId, status])
  @@index([addresseeId, status])
  @@index([requesterId, addresseeId, createdAt])
}

enum GroupInviteStatus {
  pending
  accepted
  rejected
}

model UserGroup {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  ownerId     Int
  owner       User     @relation("UserGroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members GroupMember[]
  invites GroupInvite[]
  chats   GroupChat[]

  @@index([ownerId])
}

model GroupMember {
  groupId  Int
  group    UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   Int
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime  @default(now())

  @@id([groupId, userId])
  @@index([userId])
  @@index([groupId, joinedAt])
}

model GroupInvite {
  id        Int               @id @default(autoincrement())
  groupId   Int
  group     UserGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviterId Int
  inviter   User              @relation("GroupInviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId Int
  invitee   User              @relation("GroupInviteInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  status    GroupInviteStatus @default(pending)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([inviteeId, status])
  @@index([groupId, inviteeId, createdAt])
}

model GroupChat {
  id                  Int       @id @default(autoincrement())
  groupId             Int
  group               UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  chatId              String    @unique
  title               String?
  filterMemberUserIds Int[]     @default([])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([groupId, updatedAt])
}

enum MovieWatchProviderKind {
  flatrate
  rent
  buy
}

model Movie {
  id              Int      @id @default(autoincrement())
  tmdbId          Int
  language        String
  title           String
  year            Int?
  posterPath      String?
  overview        String
  runtimeMinutes  Int?
  tmdbVoteAverage Float?
  imdbId          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  genres          MovieGenre[]
  directors       MovieDirector[]
  cast            MovieCast[]
  originCountries MovieOriginCountry[]
  watchProviders  MovieWatchProvider[]
  userEntries     UserMovieEntry[]

  @@unique([tmdbId, language])
  @@unique([imdbId, language])
}

model MovieGenre {
  id      Int    @id @default(autoincrement())
  name    String
  movieId Int
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
}

model MovieDirector {
  id      Int    @id @default(autoincrement())
  name    String
  movieId Int
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
}

model MovieCast {
  id        Int    @id @default(autoincrement())
  name      String
  sortOrder Int
  movieId   Int
  movie     Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
}

model MovieOriginCountry {
  id      Int    @id @default(autoincrement())
  code    String
  movieId Int
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
}

model MovieWatchProvider {
  id           Int                    @id @default(autoincrement())
  kind         MovieWatchProviderKind
  providerName String
  logoPath     String?
  movieId      Int
  movie        Movie                  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
}

model MovieQuerySuggestion {
  id             Int      @id @default(autoincrement())
  text           String
  textNormalized String   @unique
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model UserConversation {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId    String    @unique
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, updatedAt])
}

model UserMovieEntry {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId      Int
  movieId     Int?
  movie       Movie?    @relation(fields: [movieId], references: [id], onDelete: SetNull)
  watched     Boolean   @default(false)
  favorite    Boolean   @default(false)
  inWatchlist Boolean   @default(false)
  rating      Int? // Postgres CHECK: NULL ou inteiro entre 1 e 10 (UserMovieEntry_rating_check)
  watchedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, tmdbId])
  @@index([userId, watched])
  @@index([userId, favorite])
  @@index([userId, inWatchlist])
}
