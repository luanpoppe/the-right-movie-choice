generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  name         String
  passwordHash String?
  googleId     String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movieEntries UserMovieEntry[]
}

enum MovieWatchProviderKind {
  flatrate
  rent
  buy
}

model Movie {
  id              Int      @id @default(autoincrement())
  tmdbId          Int
  language        String
  title           String
  year            Int?
  posterPath      String?
  overview        String
  runtimeMinutes  Int?
  tmdbVoteAverage Float?
  imdbId          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  genres          MovieGenre[]
  directors       MovieDirector[]
  cast            MovieCast[]
  originCountries MovieOriginCountry[]
  watchProviders  MovieWatchProvider[]
  userEntries     UserMovieEntry[]

  @@unique([tmdbId, language])
  @@unique([imdbId, language])
}

model MovieGenre {
  id      Int    @id @default(autoincrement())
  name    String
  movieId Int
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
}

model MovieDirector {
  id      Int    @id @default(autoincrement())
  name    String
  movieId Int
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
}

model MovieCast {
  id        Int    @id @default(autoincrement())
  name      String
  sortOrder Int
  movieId   Int
  movie     Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
}

model MovieOriginCountry {
  id      Int    @id @default(autoincrement())
  code    String
  movieId Int
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
}

model MovieWatchProvider {
  id           Int                    @id @default(autoincrement())
  kind         MovieWatchProviderKind
  providerName String
  logoPath     String?
  movieId      Int
  movie        Movie                  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
}

model UserMovieEntry {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId      Int
  movieId     Int?
  movie       Movie?    @relation(fields: [movieId], references: [id], onDelete: SetNull)
  watched     Boolean   @default(false)
  favorite    Boolean   @default(false)
  inWatchlist Boolean   @default(false)
  rating      Int? // Postgres CHECK: NULL ou inteiro entre 1 e 10 (UserMovieEntry_rating_check)
  watchedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, tmdbId])
  @@index([userId, watched])
  @@index([userId, favorite])
  @@index([userId, inWatchlist])
}
