            "url": "{{baseUrl}}/auth/refresh",
            "description": "Renova o access token.\n\nEnvia `Cookie: refreshToken={{refreshToken}}` (preenchido no Login). Rotaciona o refresh e o test script atualiza `accessToken` e `refreshToken`."
          },
          "response": []
