    {
      "name": "Auth",
      "item": [
        {
          "name": "Google auth",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "function persistAuthTokens() {",
                  "    if (pm.response.code !== 200) return;",
                  "    const json = pm.response.json();",
                  "    if (json.accessToken) {",
                  "        pm.collectionVariables.set('accessToken', json.accessToken);",
                  "        pm.environment.set('accessToken', json.accessToken);",
                  "    }",
                  "    const cookieName = 'refreshToken';",
                  "    let refresh = null;",
                  "    try { refresh = pm.cookies.get(cookieName); } catch (e) {}",
                  "    if (!refresh) {",
                  "        pm.response.headers.all().forEach(function (h) {",
                  "            if (String(h.key).toLowerCase() !== 'set-cookie') return;",
                  "            const first = String(h.value).split(';')[0];",
                  "            const prefix = cookieName + '=';",
                  "            if (first.toLowerCase().indexOf(prefix.toLowerCase()) !== 0) return;",
                  "            refresh = decodeURIComponent(first.substring(prefix.length));",
                  "        });",
                  "    }",
                  "    if (refresh) {",
                  "        pm.collectionVariables.set('refreshToken', refresh);",
                  "        pm.environment.set('refreshToken', refresh);",
                  "    }",
                  "}",
                  "persistAuthTokens();"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"<cole-o-id-token-do-google-aqui>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/google",
            "description": "Autentica com ID token do Google. Vincula à conta nativa se o e-mail coincidir.\n\n**Body**\n- `idToken` (string)\n\n**Resposta**\n- `accessToken` no body → variável `accessToken`\n- cookie httpOnly `refreshToken` → variável `refreshToken` (e Cookie Jar)\n\nObtenha o token via login no frontend (DevTools > Network > POST /auth/google)."
          },
          "response": []
        },
